# Public product name.
APP_NAME="AgentKB API"
DATABASE_URL=sqlite:///./data/agentkb.db
CHROMA_PERSIST_DIR=./chroma
CHROMA_COLLECTION_NAME=agentkb_chunks
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
VECTOR_INDEX_ENABLED=true
CHUNK_SIZE=500
CHUNK_OVERLAP=80
MAX_TXT_FILE_BYTES=1048576
WIKI_ROOT_DIR=./data/wiki
WIKI_MAX_PAGE_BYTES=2000000
# How many pages a wiki query may pull in by following page links (0 disables it).
WIKI_QUERY_NEIGHBOUR_LIMIT=3
# Below this score the direct matches are weak, so a query may follow one more link hop.
WIKI_QUERY_DEEP_THRESHOLD=0.5
WIKI_QUERY_DEFAULT_STRATEGY=auto
WIKI_QUERY_VECTOR_WEIGHT=0.35
# 低于该余弦相似度不算语义命中（实测：真命中 >0.5，无关页面 0.1-0.2）
WIKI_QUERY_VECTOR_FLOOR=0.35
# Optional OpenAI-compatible answer synthesis. Keep disabled for local deterministic retrieval.
# Set LLM_BASE_URL to a provider's OpenAI-compatible API root, normally ending in /v1.
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1200
LLM_TIMEOUT_SECONDS=60
LLM_CONTEXT_MAX_CHARS=12000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
